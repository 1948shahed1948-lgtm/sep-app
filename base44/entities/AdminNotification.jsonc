{
  "name": "AdminNotification",
  "type": "object",
  "properties": {
    "target_user_id": {
      "type": "string",
      "description": "null = \u0625\u0630\u0627\u0639\u0629 \u0644\u0644\u062c\u0645\u064a\u0639\u060c \u0648\u0625\u0644\u0627 \u0645\u0639\u0631\u0651\u0641 \u0637\u0627\u0644\u0628 \u0645\u062d\u062f\u062f"
    },
    "title_ar": {
      "type": "string"
    },
    "body_ar": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "broadcast",
        "individual",
        "report"
      ]
    }
  },
  "required": [
    "title_ar",
    "kind"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.target_user_id": "{{user.id}}"
        },
        {
          "data.target_user_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
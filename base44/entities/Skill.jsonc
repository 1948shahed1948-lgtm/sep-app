{
  "name": "Skill",
  "type": "object",
  "properties": {
    "name_ar": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string",
      "description": "Reference to Lesson"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "mastery_threshold": {
      "type": "number",
      "default": 80,
      "description": "Percentage needed to master"
    }
  },
  "required": [
    "name_ar",
    "name_en",
    "lesson_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
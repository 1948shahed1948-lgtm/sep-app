{
  "name": "StudentActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "login",
        "test_started",
        "practice",
        "game"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0646\u0634\u0627\u0637"
    },
    "label_ar": {
      "type": "string"
    },
    "label_en": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0630\u064a \u062f\u062e\u0644\u0647 \u0627\u0644\u0637\u0627\u0644\u0628"
    }
  },
  "required": [
    "user_id",
    "activity_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "full_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "grade": {
      "type": "string",
      "description": "\u0627\u0644\u0635\u0641 \u0627\u0644\u062f\u0631\u0627\u0633\u064a \u0625\u0646 \u0648\u064f\u062c\u062f"
    },
    "parent_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
    },
    "parent_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "parent_relation": {
      "type": "string",
      "enum": [
        "father",
        "mother",
        "guardian"
      ],
      "description": "\u0635\u0644\u0629 \u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631: \u0627\u0644\u0623\u0628/\u0627\u0644\u0623\u0645/\u0627\u0644\u0648\u0635\u064a"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "phone"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a \u2014 \u0644\u0644\u062f\u0641\u0639 \u0628\u0627\u0644\u062c\u0647\u0627\u0632 \u0628\u062f\u0648\u0646 \u062d\u0633\u0627\u0628)"
    },
    "device_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u062c\u0647\u0627\u0632 \u0644\u0644\u062a\u062c\u0631\u0628\u0629 \u0648\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0628\u062f\u0648\u0646 \u062d\u0633\u0627\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "canceled"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643"
    },
    "plan": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0637\u0629"
    },
    "store": {
      "type": "string",
      "enum": [
        "stripe",
        "google",
        "apple",
        "revenuecat"
      ],
      "description": "\u0645\u062a\u062c\u0631 \u0627\u0644\u062f\u0641\u0639: Stripe \u0623\u0648 Google Play \u0623\u0648 App Store \u0623\u0648 RevenueCat"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "\u0646\u0647\u0627\u064a\u0629 \u0641\u062a\u0631\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u062d\u0627\u0644\u064a\u0629"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "TeacherPayout",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0639\u0644\u0645 (user_id)"
    },
    "teacher_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062d\u0648\u0651\u0644 \u0644\u0644\u0645\u0639\u0644\u0645 \u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a"
    },
    "method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "stcpay",
        "cash",
        "other"
      ],
      "default": "bank_transfer",
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644: \u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a / STC Pay / \u0646\u0642\u062f\u0627\u064b / \u0623\u062e\u0631\u0649"
    },
    "reference": {
      "type": "string",
      "description": "\u0645\u0631\u062c\u0639 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 (\u0631\u0642\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0628\u0646\u0643\u064a\u0629 \u0623\u0648 \u0625\u064a\u0635\u0627\u0644)"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending"
      ],
      "default": "completed",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0633\u0648\u064a\u0629"
    },
    "notes": {
      "type": "string"
    },
    "covers_booking_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u063a\u0637\u0651\u064a\u0647\u0627 \u0647\u0630\u0647 \u0627\u0644\u062a\u0633\u0648\u064a\u0629 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    }
  },
  "required": [
    "teacher_id",
    "teacher_name",
    "amount",
    "method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
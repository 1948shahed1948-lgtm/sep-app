{
  "name": "TeacherSubject",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0639\u0644\u0645 (user_id)"
    },
    "teacher_name": {
      "type": "string"
    },
    "subject_name_ar": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0627\u062f\u0629"
    },
    "grade": {
      "type": "string",
      "description": "\u0627\u0644\u0635\u0641 \u0627\u0644\u062f\u0631\u0627\u0633\u064a"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "online_link",
        "recorded",
        "both"
      ],
      "default": "online_link",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062c\u0644\u0633\u0629: \u0631\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631 / \u0645\u0633\u062c\u0651\u0644 / \u0643\u0644\u0627\u0647\u0645\u0627"
    },
    "description": {
      "type": "string"
    },
    "materials_url": {
      "type": "string",
      "description": "\u0631\u0627\u0628\u0637 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0627\u062f\u0629 (PDF \u0623\u0648 \u0631\u0627\u0628\u0637 \u062e\u0627\u0631\u062c\u064a) \u064a\u0631\u0641\u0639\u0647 \u0627\u0644\u0645\u0639\u0644\u0645"
    }
  },
  "required": [
    "teacher_id",
    "subject_name_ar",
    "grade"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
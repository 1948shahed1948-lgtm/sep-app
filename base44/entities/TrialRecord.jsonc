{
  "name": "TrialRecord",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u062c\u0647\u0627\u0632 \u0644\u0631\u0628\u0637 \u0633\u062c\u0644 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 (\u064a\u0645\u0646\u0639 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0643\u0631\u0627\u0631)"
    },
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0646 \u0648\u064f\u062c\u062f"
    }
  },
  "required": [
    "device_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
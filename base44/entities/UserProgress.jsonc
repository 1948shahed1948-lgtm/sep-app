{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "correct_answers": {
      "type": "number",
      "default": 0
    },
    "wrong_answers": {
      "type": "number",
      "default": 0
    },
    "mastery_percentage": {
      "type": "number",
      "default": 0
    },
    "is_mastered": {
      "type": "boolean",
      "default": false
    },
    "weak_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of weak skill IDs"
    },
    "last_attempt_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "skill_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
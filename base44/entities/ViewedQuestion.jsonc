{
  "name": "ViewedQuestion",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the student who viewed the question"
    },
    "question_ar": {
      "type": "string"
    },
    "question_en": {
      "type": "string"
    },
    "options_ar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options_en": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct_answer": {
      "type": "string",
      "description": "Index of the correct option"
    },
    "explanation_ar": {
      "type": "string"
    },
    "explanation_en": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "question_bank",
        "standardized",
        "aptitude",
        "genius"
      ],
      "default": "question_bank"
    },
    "question_id": {
      "type": "string",
      "description": "Original question entity ID (to avoid duplicates)"
    },
    "viewed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "question_ar",
    "question_en",
    "correct_answer",
    "source"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
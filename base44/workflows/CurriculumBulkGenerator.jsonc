{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomously generates 50 questions per lesson across the entire Saudi curriculum, one lesson every 5 minutes, until all 509 lessons are complete.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "curriculum_bulk_generator",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "bulkGenerateBatch",
            "args": {
              "batch_size": 1,
              "cron_secret": "9f2c4a8e1b7d3f6c5a0e2b4d7f1c8a3e5b9d6f0c"
            }
          },
          "then": "check_done",
          "x-base44": {
            "title": "\u062a\u0648\u0644\u064a\u062f \u062f\u0641\u0639\u0629 \u0623\u0633\u0626\u0644\u0629",
            "description": "\u062f\u0631\u0633 \u0648\u0627\u062d\u062f\u060c \u0665\u0660 \u0633\u0624\u0627\u0644\u0627\u064b"
          }
        }
      },
      {
        "check_done": {
          "switch": [
            {
              "when": "${ .generate_batch.remaining > 0 }",
              "then": "end"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u0643\u062a\u0645\u0627\u0644",
            "description": "remaining == 0"
          }
        }
      }
    ]
  },
  "name": "Curriculum Bulk Generator"
}
{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_whatsapp_reports",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reports": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyWhatsAppReports",
            "args": {
              "cron_secret": "9f2c4a8e1b7d3f6c5a0e2b4d7f1c8a3e5b9d6f0c"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628",
            "description": "\u0643\u0644 \u062c\u0645\u0639\u0629 \u2014 \u0644\u0644\u0637\u0627\u0644\u0628 \u0648\u0648\u0644\u064a \u0627\u0644\u0623\u0645\u0631"
          }
        }
      }
    ]
  },
  "name": "Weekly WhatsApp Reports",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 5",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "\u064a\u0631\u0633\u0644 \u062a\u0642\u0631\u064a\u0631\u0627\u064b \u0623\u0633\u0628\u0648\u0639\u064a\u0627\u064b \u0639\u0646 \u0623\u062f\u0627\u0621 \u0627\u0644\u0637\u0627\u0644\u0628 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0643\u0644 \u064a\u0648\u0645 \u062c\u0645\u0639\u0629 \u0627\u0644\u0633\u0627\u0639\u0629 \u0669 \u0635\u0628\u0627\u062d\u0627\u064b\u060c \u064a\u062a\u0636\u0645\u0646 \u0625\u0646\u062c\u0627\u0632\u0627\u062a \u0627\u0644\u0637\u0627\u0644\u0628 \u0648\u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c \u062a\u0631\u0643\u064a\u0632\u0627\u064b."
}